# URLs of sub-portals
PESC_API_URL=http://localhost:8003
GAZ_API_URL=http://localhost:8004

# Directory for SQLite database (default: ./data)
# DATA_DIR=data

# Auto-submit schedule (Moscow time, default 12:00)
# SCHEDULER_HOUR=12
# SCHEDULER_MINUTE=0

# Docker Compose / Coolify deployment
# PESC_LOGIN=79001234567
# PESC_PASSWORD=your_password
# PESC_AUTH_VERIFICATION=
# PESC_TOTP_SECRET=
# PESC_PROXY_URL=
# GAZ_LOGIN=+79001234567
# GAZ_PASSWORD=your_password
# GAZ_LSPU_ID=29238816
# GAZ_PROXY_URL=
# METERS_SCHEDULER_HOUR=12
# METERS_SCHEDULER_MINUTE=0
# PESC_SCHEDULER_HOUR=12
# PESC_SCHEDULER_MINUTE=0
# GAZ_SCHEDULER_HOUR=12
# GAZ_SCHEDULER_MINUTE=0
